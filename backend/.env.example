# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL) — matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://nairachain:nairachain@localhost:5432/nairachain

# JWT secrets — use long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_random_string_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer). Leave SMTP_HOST empty in development: emails are then
# logged to the console and verify/reset links are returned by the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NairaChain <noreply@nairachain.com>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin notifications (dispute alerts)
ADMIN_EMAIL=admin@nairachain.com

# Escrow payment window (minutes). Expired trades are auto-cancelled and refunded.
ESCROW_TIMEOUT_MINUTES=30

# Optional
# DISABLE_PRICE_FEED=true      # skip CoinGecko, use static NGN prices
# DISABLE_ESCROW_JOB=true      # don't run the expiry job in this process
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10
