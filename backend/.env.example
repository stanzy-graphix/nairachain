# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/nairachain

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer - use Gmail or Mailtrap for dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=NairaChain <noreply@nairachain.com>

# Coinbase Commerce (crypto payments)
COINBASE_API_KEY=your_coinbase_commerce_api_key
COINBASE_WEBHOOK_SECRET=your_webhook_secret

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@nairachain.com

# Escrow timeout (minutes)
ESCROW_TIMEOUT_MINUTES=30
