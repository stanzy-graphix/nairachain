# Used by docker-compose.yml. Copy to .env and fill in.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database credentials for the compose Postgres
POSTGRES_USER=nairachain
POSTGRES_PASSWORD=nairachain
POSTGRES_DB=nairachain

# URLs the browser uses (baked into the web image at build time)
PUBLIC_API_URL=http://localhost:5000/api
PUBLIC_SOCKET_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Optional: SMTP (empty = emails logged by the api container)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
